{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drumr.ai/schemas/idea-statement/1.0.json",
  "title": "DrumR Idea Statement",
  "description": "Machine-readable idea statement for import into the Problem-Solution Fit stage. Mirrors statement-IDEA-NN.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "run_id", "idea_id", "title", "one_liner", "generated_at",
    "persona", "problem_statement", "triggers", "value_proposition", "economics",
    "evidence", "scores", "assumptions_to_test"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "drumr.idea-statement" },
    "run_id": { "type": "string", "description": "Run folder name, e.g. 2026-06-19-2234" },
    "idea_id": { "type": "string", "pattern": "^IDEA-[0-9]{2}$" },
    "title": { "type": "string" },
    "one_liner": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },

    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "context", "goals", "frustrations", "current_workaround", "buying_power", "basis"],
      "properties": {
        "name": { "type": "string", "description": "Illustrative first name" },
        "role": { "type": "string" },
        "context": { "type": "string", "description": "Company type and size, team, setting" },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "frustrations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "current_workaround": { "type": "string" },
        "buying_power": { "type": "string" },
        "basis": { "type": "string", "description": "What the persona is built from; which parts are assumptions" }
      }
    },

    "problem_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "job_to_be_done", "root_cause", "impact", "current_workaround"],
      "properties": {
        "statement": { "type": "string", "description": "<Persona> struggles to <job> because <cause>, which costs them <impact>." },
        "job_to_be_done": { "type": "string" },
        "root_cause": { "type": "string" },
        "impact": { "type": "string" },
        "current_workaround": { "type": "string" }
      }
    },

    "triggers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moment", "what_happens", "frequency", "label"],
        "properties": {
          "moment": { "type": "string" },
          "what_happens": { "type": "string", "description": "What happens and why the pain peaks then" },
          "frequency": { "type": "string" },
          "label": { "$ref": "#/$defs/label" },
          "source_url": { "type": "string" }
        }
      }
    },

    "value_proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promise", "solution_wedge", "differentiation"],
      "properties": {
        "promise": { "type": "string" },
        "solution_wedge": { "type": "string" },
        "differentiation": { "type": "string" }
      }
    },

    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_assumption", "currency", "pricing_model", "expected_price", "gross_margin_pct", "customer_lifetime_months", "ltv", "max_cac", "assumptions"],
      "properties": {
        "is_assumption": { "const": true, "description": "Every figure in this block is an assumption until validated" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "pricing_model": { "type": "string" },
        "expected_price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "unit", "basis"],
          "properties": {
            "low": { "type": "number", "minimum": 0 },
            "high": { "type": "number", "minimum": 0 },
            "unit": { "type": "string", "description": "e.g. per seat per month" },
            "basis": { "type": "string" }
          }
        },
        "gross_margin_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "customer_lifetime_months": { "type": "number", "minimum": 0 },
        "ltv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "formula"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "formula": { "type": "string" }
          }
        },
        "max_cac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "formula"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "formula": { "type": "string" }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "confidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^A-[0-9]+$" },
              "statement": { "type": "string" },
              "confidence": { "enum": ["low", "medium", "high"] }
            }
          }
        }
      }
    },

    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "label"],
        "properties": {
          "claim": { "type": "string" },
          "label": { "$ref": "#/$defs/label" },
          "source_title": { "type": "string" },
          "source_url": { "type": "string" }
        }
      }
    },

    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desirability", "viability", "feasibility", "composite", "weights", "gate", "gate_reason", "rank", "rank_of"],
      "properties": {
        "desirability": { "$ref": "#/$defs/score" },
        "viability": { "$ref": "#/$defs/score" },
        "feasibility": { "$ref": "#/$defs/score" },
        "composite": { "$ref": "#/$defs/score" },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desirability", "viability", "feasibility"],
          "properties": {
            "desirability": { "type": "number" },
            "viability": { "type": "number" },
            "feasibility": { "type": "number" }
          }
        },
        "gate": { "enum": ["Advance", "Iterate", "Park"] },
        "gate_reason": { "type": "string" },
        "rank": { "type": "integer", "minimum": 1 },
        "rank_of": { "type": "integer", "minimum": 1 }
      }
    },

    "risks": { "type": "array", "items": { "type": "string" } },

    "assumptions_to_test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assumption", "test", "success_signal"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]+$" },
          "assumption": { "type": "string" },
          "test": { "type": "string" },
          "success_signal": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "label": {
      "enum": ["cited", "inference", "assumption"],
      "description": "cited = backed by a source in market-research.md; inference = reasoned from evidence; assumption = unvalidated guess"
    }
  }
}
